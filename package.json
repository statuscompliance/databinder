{
  "name": "@statuscompliance/databinder",
  "version": "1.2.3",
  "description": "A TypeScript library to simplify integration with data sources",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "eslint . --max-warnings=0 --cache --cache-location node_modules/.cache/eslint",
    "format": "eslint . --fix --max-warnings=0 --cache --cache-location node_modules/.cache/eslint",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "data",
    "integration",
    "datasource",
    "api",
    "binding"
  ],
  "author": "alvarobernal2412",
  "license": "Apache-2.0",
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "10.0.1",
    "@evilmartians/lefthook": "2.1.10",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "26.4.1",
    "commitlint": "21.2.2",
    "eslint": "10.10.0",
    "ts-node": "10.9.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@azure/identity": "4.13.1",
    "@microsoft/microsoft-graph-client": "3.0.7",
    "@opentelemetry/api": "1.9.1",
    "dotenv": "17.4.2",
    "jszip": "3.10.1",
    "mongoose": "9.7.2",
    "uuid": "13.0.2",
    "winston": "3.19.0",
    "zod": "4.4.3"
  }
}